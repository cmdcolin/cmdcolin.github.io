---
import Layout from '../layouts/Layout.astro'
import { getAllPosts } from '../../lib/api.ts'

const posts = getAllPosts()
---

<Layout title="Archive">
  <h1>Blog archive</h1>

  <section>
    <h1>Posts</h1>
    <ul>
      {
        posts.map(({ id, date, title }) => (
          <li>
            <a href={`/posts/${id}/`}>
              {date.slice(0, 10)} - {title}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
