---
import { getAllPosts } from '../../../lib/api.ts'
import Container from '../../components/container.astro'
import GiscusBox from '../../components/giscus.astro'
import Layout from '../../layouts/Layout.astro'

export function getStaticPaths() {
  return getAllPosts().map(post => ({
    params: { id: post.id },
    props: post,
  }))
}

const { title, date, Content } = Astro.props
---

<Layout title={title} description={title}>
  <Container>
    <article>
      <div>
        <h1>{title}</h1>
        <h4>{date.slice(0, 10)}</h4>
      </div>
      <div class="post-content">
        <Content />
      </div>
      <GiscusBox />
    </article>
  </Container>
</Layout>

<style>
  article {
    max-width: 100%;
  }

  .post-content {
    margin: 2rem 0;
    line-height: 1.6;
  }
</style>
