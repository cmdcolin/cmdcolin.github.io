{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "warn"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "es2024": true
  },
  "rules": {
    "unicorn/filename-case": "off",
    "unicorn/no-null": "off",
    "import/no-unassigned-import": "off"
  },
  "ignorePatterns": ["dist", ".astro", "public"]
}
